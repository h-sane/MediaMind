<Page
	x:Class="Files.App.Views.People.DuplicatesPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.Views.People"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:vm="using:Files.App.ViewModels.People"
	mc:Ignorable="d">

	<Page.Resources>
		<!--  Keep = the soft green of Yes, remove = the soft red of Delete (same tints as Who's who)  -->
		<ResourceDictionary>
			<ResourceDictionary.ThemeDictionaries>
				<ResourceDictionary x:Key="Default">
					<SolidColorBrush x:Key="DupKeepFill" Color="#2E3FB950" />
					<SolidColorBrush x:Key="DupKeepStroke" Color="#993FB950" />
					<SolidColorBrush x:Key="DupKeepText" Color="#8DDB8C" />
					<SolidColorBrush x:Key="DupRemoveFill" Color="#2EF85149" />
					<SolidColorBrush x:Key="DupRemoveText" Color="#FF9492" />
				</ResourceDictionary>
				<ResourceDictionary x:Key="Light">
					<SolidColorBrush x:Key="DupKeepFill" Color="#1F1A7F37" />
					<SolidColorBrush x:Key="DupKeepStroke" Color="#991A7F37" />
					<SolidColorBrush x:Key="DupKeepText" Color="#116329" />
					<SolidColorBrush x:Key="DupRemoveFill" Color="#1FCF222E" />
					<SolidColorBrush x:Key="DupRemoveText" Color="#A40E26" />
				</ResourceDictionary>
			</ResourceDictionary.ThemeDictionaries>
		</ResourceDictionary>
	</Page.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header: what this page is for, and the one action that refreshes it  -->
		<Grid
			Grid.Row="0"
			Margin="24,16,24,8"
			ColumnSpacing="16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<StackPanel Spacing="2">
				<TextBlock
					x:Name="TitleText"
					FontSize="20"
					FontWeight="SemiBold"
					Text="{x:Bind ViewModel.Title, Mode=OneWay}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					MaxWidth="640"
					HorizontalAlignment="Left"
					Opacity="0.7"
					Style="{StaticResource CaptionTextBlockStyle}"
					Text="{helpers:ResourceString Name=MediaMind_DupSubtitle}"
					TextWrapping="Wrap" />
			</StackPanel>
			<StackPanel
				Grid.Column="1"
				VerticalAlignment="Center"
				Orientation="Horizontal"
				Spacing="12">
				<ProgressRing
					Width="20"
					Height="20"
					IsActive="{x:Bind ViewModel.IsWorking, Mode=OneWay}" />
				<Button
					x:Name="FindButton"
					Click="FindButton_Click"
					IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
					ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupFindTip}">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon FontSize="14" Glyph="&#xE72C;" />
						<TextBlock Text="{helpers:ResourceString Name=MediaMind_DupFindAgain}" />
					</StackPanel>
				</Button>
			</StackPanel>
		</Grid>

		<InfoBar
			x:Name="StatusBar"
			Grid.Row="1"
			Margin="24,0,24,8"
			IsOpen="{x:Bind ViewModel.StatusOpen, Mode=TwoWay}"
			Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
			Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

		<!--  Blocking state: no duplicate check yet / engine unavailable  -->
		<StackPanel
			Grid.Row="2"
			MaxWidth="420"
			Margin="24,64,24,0"
			HorizontalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind ViewModel.BlockingVisibility, Mode=OneWay}">
			<FontIcon
				FontSize="32"
				Glyph="&#xE8C8;"
				Opacity="0.6" />
			<TextBlock
				HorizontalAlignment="Center"
				Text="{x:Bind ViewModel.BlockingText, Mode=OneWay}"
				TextAlignment="Center"
				TextWrapping="Wrap" />
			<Button
				x:Name="FindFirstButton"
				HorizontalAlignment="Center"
				Click="FindButton_Click"
				Content="{helpers:ResourceString Name=MediaMind_DupFind}"
				IsEnabled="{x:Bind ViewModel.CanScan, Mode=OneWay}"
				Style="{ThemeResource AccentButtonStyle}" />
		</StackPanel>

		<!--  Body: the sets (left) and the copies of the current set side by side (right)  -->
		<Grid
			Grid.Row="2"
			Margin="24,0,24,0"
			ColumnSpacing="16"
			Visibility="{x:Bind ViewModel.ContentVisibility, Mode=OneWay}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="QueueColumn" Width="300" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Grid RowSpacing="8">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<!--  Exact copies and look-alikes are reviewed apart: the first can go in bulk, the second needs a look  -->
				<StackPanel Spacing="6">
					<SelectorBar x:Name="ModeBar" SelectionChanged="ModeBar_SelectionChanged">
						<SelectorBarItem x:Name="ExactModeItem" Text="{x:Bind ViewModel.ExactLabel, Mode=OneWay}" />
						<SelectorBarItem x:Name="LookAlikeModeItem" Text="{x:Bind ViewModel.LookAlikeLabel, Mode=OneWay}" />
					</SelectorBar>
					<Grid Margin="12,0,0,0" ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							VerticalAlignment="Center"
							Opacity="0.7"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
							TextTrimming="CharacterEllipsis" />
						<HyperlinkButton
							x:Name="SelectAllButton"
							Grid.Column="1"
							Padding="6,2"
							Click="SelectAll_Click"
							Content="{helpers:ResourceString Name=MediaMind_DupSelectAll}"
							Visibility="{x:Bind ViewModel.SelectAllVisibility, Mode=OneWay}" />
					</Grid>
				</StackPanel>
				<ListView
					x:Name="GroupList"
					Grid.Row="1"
					Padding="0,0,0,12"
					AutomationProperties.Name="{helpers:ResourceString Name=MediaMind_DupListName}"
					ContainerContentChanging="GroupList_ContainerContentChanging"
					ItemsSource="{x:Bind ViewModel.Groups, Mode=OneWay}"
					SelectionChanged="GroupList_SelectionChanged"
					SelectionMode="Extended">
					<ListView.ItemTemplate>
						<DataTemplate x:DataType="vm:DuplicateGroupViewModel">
							<Grid Padding="0,6" ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="56" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid
									Width="56"
									Height="56"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									CornerRadius="{StaticResource ControlCornerRadius}">
									<FontIcon
										FontSize="18"
										Glyph="&#xE8C8;"
										Opacity="0.35" />
									<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
								</Grid>
								<StackPanel Grid.Column="1" VerticalAlignment="Center">
									<TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
									<TextBlock
										Opacity="0.7"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="{x:Bind Detail, Mode=OneWay}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>

			<!--  Nothing left in this folder  -->
			<StackPanel
				Grid.Column="1"
				Margin="0,64,0,0"
				HorizontalAlignment="Center"
				Spacing="8"
				Visibility="{x:Bind ViewModel.DoneVisibility, Mode=OneWay}">
				<FontIcon
					FontSize="32"
					Glyph="&#xE73E;"
					Opacity="0.6" />
				<TextBlock
					HorizontalAlignment="Center"
					Text="{helpers:ResourceString Name=MediaMind_DupAllDone}"
					TextAlignment="Center"
					TextWrapping="Wrap" />
			</StackPanel>

			<Grid
				Grid.Column="1"
				Padding="0,0,0,16"
				RowSpacing="12"
				Visibility="{x:Bind ViewModel.CompareVisibility, Mode=OneWay}">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<TextBlock
					x:Name="MatchText"
					Opacity="0.8"
					Text="{x:Bind ViewModel.MatchText, Mode=OneWay}"
					TextWrapping="Wrap" />

				<!--  The copies side by side, equal widths; click one to keep it (or press its number)  -->
				<ScrollViewer
					x:Name="CompareScroller"
					Grid.Row="1"
					HorizontalScrollMode="Disabled"
					SizeChanged="CompareScroller_SizeChanged"
					VerticalScrollBarVisibility="Auto">
					<ItemsRepeater
						x:Name="CopiesRepeater"
						ElementClearing="CopiesRepeater_ElementClearing"
						ElementPrepared="CopiesRepeater_ElementPrepared"
						ItemsSource="{x:Bind ViewModel.Current.Members, Mode=OneWay}">
						<ItemsRepeater.Layout>
							<UniformGridLayout
								x:Name="CopiesLayout"
								ItemsStretch="Fill"
								MinColumnSpacing="12"
								MinItemWidth="240"
								MinRowSpacing="12" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate x:DataType="vm:DuplicateMemberViewModel">
								<Grid
									AutomationProperties.Name="{x:Bind FileName}"
									Background="{ThemeResource SubtleFillColorSecondaryBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="2"
									CornerRadius="{StaticResource OverlayCornerRadius}"
									DoubleTapped="Copy_DoubleTapped"
									PointerEntered="Copy_PointerEntered"
									PointerExited="Copy_PointerExited"
									Tapped="Copy_Tapped">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid
										x:Name="CopyImageArea"
										Height="340"
										Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}">
										<FontIcon
											FontSize="24"
											Glyph="&#xE8C8;"
											Opacity="0.3" />
										<Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
										<!--  Videos play here, looping and muted; the one under the pointer has sound  -->
										<MediaPlayerElement
											x:Name="CopyPlayer"
											AreTransportControlsEnabled="False"
											Stretch="Uniform"
											Visibility="Collapsed" />
										<!--  Its number (the key that picks it)  -->
										<Border
											Margin="10"
											Padding="8,2"
											HorizontalAlignment="Left"
											VerticalAlignment="Top"
											Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
											CornerRadius="{StaticResource ControlCornerRadius}">
											<TextBlock FontWeight="SemiBold" Text="{x:Bind NumberText}" />
										</Border>
										<!--  Keep / Remove, in the tints the answer buttons use  -->
										<Border
											Margin="10"
											Padding="10,3"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Background="{ThemeResource DupKeepFill}"
											BorderBrush="{ThemeResource DupKeepStroke}"
											BorderThickness="1"
											CornerRadius="{StaticResource ControlCornerRadius}"
											Visibility="{x:Bind KeepVisibility, Mode=OneWay}">
											<StackPanel Orientation="Horizontal" Spacing="6">
												<FontIcon
													FontSize="12"
													Foreground="{ThemeResource DupKeepText}"
													Glyph="&#xE73E;" />
												<TextBlock Foreground="{ThemeResource DupKeepText}" Text="{helpers:ResourceString Name=MediaMind_DupKeepBadge}" />
											</StackPanel>
										</Border>
										<Border
											Margin="10"
											Padding="10,3"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Background="{ThemeResource DupRemoveFill}"
											CornerRadius="{StaticResource ControlCornerRadius}"
											Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
											<TextBlock Foreground="{ThemeResource DupRemoveText}" Text="{helpers:ResourceString Name=MediaMind_DupRemoveBadge}" />
										</Border>
										<Border
											Margin="10"
											Padding="4,2"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Background="{ThemeResource SmokeFillColorDefaultBrush}"
											CornerRadius="3"
											Visibility="{x:Bind VideoBadgeVisibility}">
											<FontIcon
												FontSize="12"
												Foreground="White"
												Glyph="&#xE714;" />
										</Border>
										<!--  This copy full screen: zoom, and a video with sound and its controls  -->
										<Button
											Margin="10"
											Padding="8,6"
											HorizontalAlignment="Right"
											VerticalAlignment="Bottom"
											AutomationProperties.Name="{helpers:ResourceString Name=MediaMind_DupViewFull}"
											Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
											Click="CopyFullScreen_Click"
											Tag="{x:Bind}"
											ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupViewFullTip}">
											<FontIcon FontSize="14" Glyph="&#xE740;" />
										</Button>
									</Grid>
									<!--  The copy that stays: outlined in the keep green  -->
									<Border
										Grid.RowSpan="2"
										BorderBrush="{ThemeResource DupKeepStroke}"
										BorderThickness="2"
										CornerRadius="{StaticResource OverlayCornerRadius}"
										IsHitTestVisible="False"
										Visibility="{x:Bind KeepVisibility, Mode=OneWay}" />
									<StackPanel
										Grid.Row="1"
										Padding="12,10,12,12"
										Spacing="2">
										<TextBlock
											FontWeight="SemiBold"
											Text="{x:Bind FileName}"
											TextTrimming="CharacterEllipsis"
											ToolTipService.ToolTip="{x:Bind AbsPath}" />
										<TextBlock
											Opacity="0.8"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="{x:Bind Folder}"
											TextTrimming="CharacterEllipsis" />
										<TextBlock
											Opacity="0.7"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="{x:Bind Facts}" />
										<TextBlock
											Opacity="0.7"
											Style="{StaticResource CaptionTextBlockStyle}"
											Text="{x:Bind Modified}" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</ScrollViewer>

				<!--  Answers stay pinned below the copies  -->
				<StackPanel Grid.Row="2" Spacing="8">
					<toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
						<Button
							x:Name="KeepButton"
							MinWidth="120"
							AutomationProperties.Name="{x:Bind ViewModel.KeepText, Mode=OneWay}"
							Click="KeepButton_Click"
							IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}">
							<Button.Resources>
								<ResourceDictionary>
									<ResourceDictionary.ThemeDictionaries>
										<ResourceDictionary x:Key="Default">
											<SolidColorBrush x:Key="ButtonBackground" Color="#2E3FB950" />
											<SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#473FB950" />
											<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#243FB950" />
											<SolidColorBrush x:Key="ButtonBorderBrush" Color="#663FB950" />
											<SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#803FB950" />
											<SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#553FB950" />
											<SolidColorBrush x:Key="ButtonForeground" Color="#8DDB8C" />
											<SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#A6E9A5" />
											<SolidColorBrush x:Key="ButtonForegroundPressed" Color="#8DDB8C" />
										</ResourceDictionary>
										<ResourceDictionary x:Key="Light">
											<SolidColorBrush x:Key="ButtonBackground" Color="#1F1A7F37" />
											<SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#331A7F37" />
											<SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#141A7F37" />
											<SolidColorBrush x:Key="ButtonBorderBrush" Color="#551A7F37" />
											<SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#701A7F37" />
											<SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#441A7F37" />
											<SolidColorBrush x:Key="ButtonForeground" Color="#116329" />
											<SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#0B4F20" />
											<SolidColorBrush x:Key="ButtonForegroundPressed" Color="#116329" />
										</ResourceDictionary>
									</ResourceDictionary.ThemeDictionaries>
								</ResourceDictionary>
							</Button.Resources>
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="14" Glyph="&#xE73E;" />
								<TextBlock Text="{x:Bind ViewModel.KeepText, Mode=OneWay}" />
							</StackPanel>
						</Button>
						<Button
							x:Name="NotDuplicatesButton"
							Click="NotDuplicatesButton_Click"
							IsEnabled="{x:Bind ViewModel.CanDecide, Mode=OneWay}"
							ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupNotDuplicatesTip}">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<FontIcon FontSize="14" Glyph="&#xE711;" />
								<TextBlock Text="{helpers:ResourceString Name=MediaMind_DupNotDuplicates}" />
							</StackPanel>
						</Button>
						<Button
							x:Name="SkipButton"
							Click="SkipButton_Click"
							Content="{helpers:ResourceString Name=MediaMind_ReviewSkip}" />
					</toolkit:WrapPanel>
					<TextBlock
						Opacity="0.7"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="{helpers:ResourceString Name=MediaMind_DupKeysHint}"
						TextWrapping="Wrap" />
					<HyperlinkButton
						x:Name="AskAgainLink"
						Margin="-12,-6,0,0"
						Click="AskAgain_Click"
						Content="{helpers:ResourceString Name=MediaMind_ReviewAskAgain}"
						FontSize="12"
						Visibility="Collapsed" />
					<TextBlock
						Foreground="{ThemeResource SystemFillColorCriticalBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="{x:Bind ViewModel.ErrorText, Mode=OneWay}"
						TextWrapping="Wrap"
						Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}" />
				</StackPanel>
			</Grid>
		</Grid>
		<!--  One copy, full screen: the whole picture (zoom) or the video (sound, seek) at full height,
		     with the copy's details and the choices in a column on the right  -->
		<Grid
			x:Name="CopyViewer"
			Grid.RowSpan="3"
			Padding="16,12,16,16"
			Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
			ColumnSpacing="16"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition x:Name="CopyViewerSideColumn" Width="300" />
			</Grid.ColumnDefinitions>
			<Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{StaticResource OverlayCornerRadius}">
				<local:MediaZoomView x:Name="CopyMedia" Margin="8" />
				<ProgressRing
					x:Name="CopyViewerRing"
					Width="32"
					Height="32" />
			</Grid>
			<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
				<StackPanel Padding="0,0,4,0" Spacing="8">
					<Button
						HorizontalAlignment="Stretch"
						HorizontalContentAlignment="Left"
						AutomationProperties.Name="{helpers:ResourceString Name=MediaMind_DupViewClose}"
						Click="CopyViewerClose_Click"
						ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupViewClose}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<FontIcon FontSize="14" Glyph="&#xE73F;" />
							<TextBlock Text="{helpers:ResourceString Name=MediaMind_DupViewClose}" />
						</StackPanel>
					</Button>
					<TextBlock
						x:Name="CopyViewerTitle"
						Margin="0,8,0,0"
						Style="{StaticResource BodyStrongTextBlockStyle}"
						TextWrapping="Wrap" />
					<TextBlock
						x:Name="CopyViewerFacts"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						Style="{StaticResource CaptionTextBlockStyle}"
						TextWrapping="Wrap" />
					<Grid Margin="0,8,0,0" ColumnSpacing="8">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="*" />
						</Grid.ColumnDefinitions>
						<Button
							x:Name="CopyViewerPrevious"
							HorizontalAlignment="Stretch"
							AutomationProperties.Name="{helpers:ResourceString Name=MediaMind_DupViewPrevious}"
							Click="CopyViewerPrevious_Click"
							ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupViewPrevious}">
							<FontIcon FontSize="14" Glyph="&#xE76B;" />
						</Button>
						<Button
							x:Name="CopyViewerNext"
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							AutomationProperties.Name="{helpers:ResourceString Name=MediaMind_DupViewNext}"
							Click="CopyViewerNext_Click"
							ToolTipService.ToolTip="{helpers:ResourceString Name=MediaMind_DupViewNext}">
							<FontIcon FontSize="14" Glyph="&#xE76C;" />
						</Button>
					</Grid>
					<Button
						x:Name="CopyViewerKeep"
						HorizontalAlignment="Stretch"
						Click="CopyViewerKeep_Click"
						Style="{ThemeResource AccentButtonStyle}" />
					<Button
						HorizontalAlignment="Stretch"
						Click="CopyViewerOpen_Click"
						Content="{helpers:ResourceString Name=MediaMind_ReviewOpenFile}" />
					<TextBlock
						Margin="0,8,0,0"
						Opacity="0.6"
						Style="{StaticResource CaptionTextBlockStyle}"
						Text="{helpers:ResourceString Name=MediaMind_DupViewKeysHint}"
						TextWrapping="Wrap" />
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Page>
