<ContentDialog
	x:Class="Files.App.Dialogs.BootstrapWizardDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:dialogs="using:Files.App.Dialogs"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	Title="{helpers:ResourceString Name=MediaMind_BootstrapHeader}"
	CloseButtonText="{helpers:ResourceString Name=Close}"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<wctconverters:BoolToVisibilityConverter
			x:Key="BoolVisibilityConverter"
			FalseValue="Collapsed"
			TrueValue="Visible" />
		<wctconverters:BoolToVisibilityConverter
			x:Key="InvertedBoolVisibilityConverter"
			FalseValue="Visible"
			TrueValue="Collapsed" />
	</ContentDialog.Resources>

	<Grid Width="480" MinHeight="160">

		<!--  Loading  -->
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Spacing="12"
			Visibility="{x:Bind IsLoading, Converter={StaticResource BoolVisibilityConverter}, Mode=OneWay}">
			<ProgressRing IsActive="True" />
			<TextBlock
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Text="{helpers:ResourceString Name=MediaMind_BootstrapScanning}" />
		</StackPanel>

		<!--  Empty state  -->
		<TextBlock
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Foreground="{ThemeResource TextFillColorSecondaryBrush}"
			Text="{helpers:ResourceString Name=MediaMind_BootstrapEmpty}"
			TextAlignment="Center"
			TextWrapping="WrapWholeWords"
			Visibility="{x:Bind IsEmpty, Converter={StaticResource BoolVisibilityConverter}, Mode=OneWay}" />

		<!--  Proposals  -->
		<ScrollViewer
			MaxHeight="420"
			Visibility="{x:Bind HasProposals, Converter={StaticResource BoolVisibilityConverter}, Mode=OneWay}">
			<StackPanel Spacing="4">
				<TextBlock
					Padding="2,0,2,8"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="{helpers:ResourceString Name=MediaMind_BootstrapIntro}"
					TextWrapping="WrapWholeWords" />
				<ItemsControl ItemsSource="{x:Bind Proposals}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="dialogs:BootstrapProposal">
							<Grid
								Padding="12"
								Margin="0,0,0,4"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								ColumnSpacing="12"
								CornerRadius="4">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel Grid.Column="0" VerticalAlignment="Center">
									<TextBlock Text="{x:Bind PersonSummary}" TextTrimming="CharacterEllipsis" />
									<TextBlock
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Style="{StaticResource CaptionTextBlockStyle}"
										Text="{x:Bind Detail}"
										TextTrimming="CharacterEllipsis" />
								</StackPanel>
								<StackPanel
									Grid.Column="1"
									Orientation="Horizontal"
									Spacing="4"
									Visibility="{x:Bind IsResolved, Converter={StaticResource InvertedBoolVisibilityConverter}, Mode=OneWay}">
									<Button
										Click="Accept_Click"
										Content="{helpers:ResourceString Name=MediaMind_BootstrapAdd}"
										Style="{StaticResource AccentButtonStyle}"
										Tag="{x:Bind}" />
									<Button
										Click="Dismiss_Click"
										Content="{helpers:ResourceString Name=Dismiss}"
										Tag="{x:Bind}" />
								</StackPanel>
								<TextBlock
									Grid.Column="1"
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind ResolvedText, Mode=OneWay}"
									Visibility="{x:Bind IsResolved, Converter={StaticResource BoolVisibilityConverter}, Mode=OneWay}" />
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</ContentDialog>
