<UserControl
	x:Class="Files.App.UserControls.MediaMind.SuggestionsPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:converters="using:CommunityToolkit.WinUI.Converters"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:local="using:Files.App.Converters"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mm="using:Files.App.ViewModels.UserControls.MediaMind"
	mc:Ignorable="d">

	<UserControl.Resources>
		<ResourceDictionary>
			<converters:BoolNegationConverter x:Key="BoolNegationConverter" />
			<local:EnumToBoolConverter x:Key="EnumToBoolConverter" />
		</ResourceDictionary>
	</UserControl.Resources>

	<Grid x:Name="RootGrid">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Header  -->
		<TextBlock
			Margin="12,8,12,8"
			VerticalAlignment="Center"
			FontSize="14"
			Style="{StaticResource BodyStrongTextBlockStyle}"
			Text="{helpers:ResourceString Name=MediaMind_Suggestions}" />

		<!--  Suggestion Cards  -->
		<ListView
			x:Name="SuggestionsListView"
			Grid.Row="1"
			Padding="12,0,12,12"
			VerticalAlignment="Stretch"
			ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
			ScrollViewer.VerticalScrollBarVisibility="Auto"
			SelectionMode="None">

			<ListView.ItemContainerStyle>
				<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
					<Setter Property="Margin" Value="0,2,0,2" />
					<Setter Property="Padding" Value="0" />
					<Setter Property="HorizontalContentAlignment" Value="Stretch" />
				</Style>
			</ListView.ItemContainerStyle>

			<ListView.ItemTemplate>
				<DataTemplate x:DataType="mm:SuggestionItem">
					<Grid
						Padding="12,8,12,8"
						HorizontalAlignment="Stretch"
						Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="{StaticResource OverlayCornerRadius}"
						RowSpacing="4">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<TextBlock
							Grid.Row="0"
							Style="{StaticResource BodyTextBlockStyle}"
							Text="{x:Bind Header, Mode=OneTime}"
							TextTrimming="CharacterEllipsis" />

						<TextBlock
							Grid.Row="1"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Style="{StaticResource CaptionTextBlockStyle}"
							Text="{x:Bind SubText, Mode=OneTime}"
							TextTrimming="CharacterEllipsis" />

						<!--  Pending match: "is this the same person?" — the person's own reference
						      face next to a representative uncertain candidate face  -->
						<StackPanel
							x:Name="PendingMatchThumbnailsPanel"
							Grid.Row="2"
							Margin="0,4,0,0"
							x:Load="{x:Bind Kind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PendingMatch, Mode=OneTime}"
							Orientation="Horizontal"
							Spacing="8">
							<PersonPicture
								Width="40"
								Height="40"
								ProfilePicture="{x:Bind PersonThumbnail, Mode=OneWay}" />
							<FontIcon
								VerticalAlignment="Center"
								FontSize="14"
								Glyph="&#xE8AB;" />
							<PersonPicture
								Width="40"
								Height="40"
								ProfilePicture="{x:Bind CandidateThumbnail, Mode=OneWay}" />
						</StackPanel>

						<StackPanel
							Grid.Row="3"
							Margin="0,4,0,0"
							Orientation="Horizontal"
							Spacing="8">

							<!--  Duplicate: single "not a duplicate" dismiss  -->
							<Button
								x:Name="NotADuplicateButton"
								x:Load="{x:Bind Kind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Duplicate, Mode=OneTime}"
								Click="NotADuplicateButton_Click"
								Content="{helpers:ResourceString Name=MediaMind_NotADuplicate}" />

							<!--  Pending match: opens the full bulk-review gallery in the main frame  -->
							<Button
								x:Name="ReviewPendingButton"
								x:Load="{x:Bind Kind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=PendingMatch, Mode=OneTime}"
								Click="ReviewPendingButton_Click"
								Content="{helpers:ResourceString Name=MediaMind_ReviewMatches}"
								Style="{ThemeResource AccentButtonStyle}" />

							<!--  Consistency: this outlier belongs elsewhere / keep it here  -->
							<Button
								x:Name="MoveOutlierButton"
								x:Load="{x:Bind Kind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Consistency, Mode=OneTime}"
								Click="MoveOutlierButton_Click"
								Content="{helpers:ResourceString Name=MediaMind_MoveOut}"
								Style="{ThemeResource AccentButtonStyle}" />
							<Button
								x:Name="KeepOutlierButton"
								x:Load="{x:Bind Kind, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Consistency, Mode=OneTime}"
								Click="KeepOutlierButton_Click"
								Content="{helpers:ResourceString Name=MediaMind_KeepHere}" />

						</StackPanel>
					</Grid>
				</DataTemplate>
			</ListView.ItemTemplate>

		</ListView>

		<!--  Empty State  -->
		<TextBlock
			x:Name="NoItemsMessageTextBlock"
			Grid.Row="1"
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			x:Load="{x:Bind ViewModel.HasAnyItem, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
			Text="{helpers:ResourceString Name=MediaMind_NoSuggestions}" />

	</Grid>
</UserControl>
