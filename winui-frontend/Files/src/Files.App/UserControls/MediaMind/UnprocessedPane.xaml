<UserControl
	x:Class="Files.App.UserControls.MediaMind.UnprocessedPane"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mm="using:Files.App.ViewModels.UserControls.MediaMind"
	mc:Ignorable="d">

	<!--  The lower half of the folder view: files the scan could not read, kept with the reason so each can be tagged by hand.  -->
	<Grid
		Background="{ThemeResource LayerFillColorDefaultBrush}"
		BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
		BorderThickness="0,1,0,0"
		Visibility="{x:Bind ViewModel.PaneVisibility, Mode=OneWay}">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Button
			Padding="16,8"
			HorizontalAlignment="Stretch"
			HorizontalContentAlignment="Left"
			Background="Transparent"
			BorderThickness="0"
			Click="Header_Click"
			CornerRadius="0">
			<StackPanel
				Orientation="Horizontal"
				Spacing="10">
				<FontIcon
					VerticalAlignment="Center"
					FontSize="12"
					Glyph="{x:Bind ViewModel.ChevronGlyph, Mode=OneWay}" />
				<TextBlock
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Text="{x:Bind ViewModel.HeaderText, Mode=OneWay}" />
			</StackPanel>
		</Button>

		<StackPanel
			Grid.Row="1"
			Padding="16,0,16,12"
			Spacing="8"
			Visibility="{x:Bind ViewModel.BodyVisibility, Mode=OneWay}">
			<TextBlock
				Foreground="{ThemeResource TextFillColorSecondaryBrush}"
				Style="{StaticResource CaptionTextBlockStyle}"
				Text="{helpers:ResourceString Name=MediaMind_UnprocessedHint}"
				TextWrapping="Wrap" />

			<ListView
				MaxHeight="232"
				ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
				SelectionMode="None">
				<ListView.ItemContainerStyle>
					<Style
						BasedOn="{StaticResource DefaultListViewItemStyle}"
						TargetType="ListViewItem">
						<Setter Property="Padding" Value="0" />
						<Setter Property="MinHeight" Value="52" />
						<Setter Property="HorizontalContentAlignment" Value="Stretch" />
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="mm:UnprocessedItemViewModel">
						<Grid
							Padding="4,6"
							ColumnSpacing="12"
							DoubleTapped="Item_DoubleTapped"
							Tag="{x:Bind}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Border
								Width="36"
								Height="36"
								Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
								CornerRadius="{StaticResource ControlCornerRadius}">
								<FontIcon
									FontSize="16"
									Glyph="{x:Bind Glyph}" />
							</Border>

							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Spacing="2">
								<TextBlock
									FontWeight="SemiBold"
									MaxLines="1"
									Text="{x:Bind Name}"
									TextTrimming="CharacterEllipsis"
									ToolTipService.ToolTip="{x:Bind AbsPath}" />
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									MaxLines="2"
									Style="{StaticResource CaptionTextBlockStyle}"
									Text="{x:Bind Detail}"
									TextTrimming="CharacterEllipsis"
									TextWrapping="Wrap" />
							</StackPanel>

							<StackPanel
								Grid.Column="2"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="8">
								<TextBlock
									VerticalAlignment="Center"
									MaxWidth="180"
									Text="{x:Bind TaggedText}"
									TextTrimming="CharacterEllipsis"
									Visibility="{x:Bind TaggedVisibility}" />
								<Button
									Click="Open_Click"
									Content="{helpers:ResourceString Name=MediaMind_UnprocessedOpen}"
									Tag="{x:Bind}" />
								<Button
									Click="Tag_Click"
									Content="{helpers:ResourceString Name=MediaMind_UnprocessedTag}"
									Style="{StaticResource AccentButtonStyle}"
									Tag="{x:Bind}"
									Visibility="{x:Bind UntaggedVisibility}" />
								<Button
									Click="Untag_Click"
									Content="{helpers:ResourceString Name=MediaMind_UnprocessedRemoveTag}"
									Tag="{x:Bind}"
									Visibility="{x:Bind TaggedVisibility}" />
							</StackPanel>
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
		</StackPanel>
	</Grid>
</UserControl>
